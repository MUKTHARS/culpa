# Culpa API configuration. Copy to .env and fill in. Every value has a safe local default.

APP_ENV=development
LOG_LEVEL=INFO

# --- Storage -----------------------------------------------------------------
# Default: a local SQLite file (apps/api/culpa.db). Docker Compose sets Postgres.
# DATABASE_URL=postgresql://culpa:culpa@localhost:5433/culpa
# Empty = no Redis: cache falls back to in-process LRU, queue runs inline.
REDIS_URL=
# auto | redis | inline
QUEUE_MODE=auto
RUN_WORKERS_IN_PROCESS=true
# Safety net: pull recent PayPal disputes in case a webhook was missed (seconds)
RECONCILE_INTERVAL_S=900

# --- PayPal (developer.paypal.com > Apps & Credentials > Sandbox) ------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the app's webhook settings (needed to verify signatures)
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# Only for local testing without PAYPAL_WEBHOOK_ID. Never true in production.
ALLOW_UNVERIFIED_WEBHOOKS=false

# --- Google Gemini (aistudio.google.com > Get API key) -----------------------
GEMINI_API_KEY=
LLM_JUDGE_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0

# --- Security ----------------------------------------------------------------
# Long random string. Signs buyer mandates.
MANDATE_SIGNING_SECRET=change-me-to-a-long-random-string
# Dispute-console login. The account is created in the database at startup (password stored as a scrypt hash);
# changing the password here updates it and ends existing sessions. Leave empty locally for an open console.
# Required in production.
ANALYST_USERNAME=
ANALYST_PASSWORD=
# Comma-separated origins allowed to call the API
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Public URLs (used in PayPal return links) -------------------------------
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000

# --- Settlement policy -------------------------------------------------------
AUTO_SETTLE=false
CONFIDENCE_THRESHOLD=0.8

