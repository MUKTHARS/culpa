# Culpa API configuration. Copy this file to .env and fill in the empty values. .env is git-ignored.

APP_ENV=development
LOG_LEVEL=INFO

# Leave DATABASE_URL unset to use the local SQLite file apps/api/culpa.db
# DATABASE_URL=postgresql://culpa:culpa@127.0.0.1:5433/culpa

# Set after Redis is running (e.g. docker compose up -d redis):
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
QUEUE_MODE=auto
RUN_WORKERS_IN_PROCESS=true
# Pull PayPal disputes every 30 seconds (works locally without a public webhook URL)
RECONCILE_INTERVAL_S=30

# PayPal sandbox
# developer.paypal.com > Apps & Credentials > Sandbox app: client ID and secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID of the app (needed to verify webhook signatures; optional locally)
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
ALLOW_UNVERIFIED_WEBHOOKS=false

ANALYST_USERNAME=analyst
ANALYST_PASSWORD=QsHjrvQpsB5qxNXY
# Security
# Long random string that signs buyer mandates
MANDATE_SIGNING_SECRET=
# Dispute-console login (stored hashed in the database at startup)
ANALYST_USERNAME=
ANALYST_PASSWORD=
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_WEB_URL=http://127.0.0.1:3000

AUTO_SETTLE=false
CONFIDENCE_THRESHOLD=0.8

# --- Google Gemini (aistudio.google.com > Get API key) -----------------------
GEMINI_API_KEY=
LLM_JUDGE_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0
